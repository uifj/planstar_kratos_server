# Environment overrides for planstar/admin.
# Every ADMIN_* variable is merged over configs/config.yaml (or
# configs/config.docker.yaml) at startup. Never commit real secrets.

ADMIN_SERVER_ENV=prod
ADMIN_DATA_DATABASE_DRIVER=mysql
ADMIN_DATA_DATABASE_SOURCE=
ADMIN_DATA_DATABASE_DEBUG=false
ADMIN_DATA_DATABASE_AUTO_MIGRATE=false
ADMIN_DATA_DATABASE_MAX_OPEN_CONNS=20
ADMIN_DATA_DATABASE_MAX_IDLE_CONNS=10
ADMIN_DATA_DATABASE_CONN_MAX_LIFETIME=30m
ADMIN_DATA_REDIS_ADDR=redis:6379
ADMIN_DATA_REDIS_READ_TIMEOUT=0.5s
ADMIN_DATA_REDIS_WRITE_TIMEOUT=0.5s

ADMIN_AUTH_JWT_SECRET=
ADMIN_AUTH_COOKIE_NAME=psAdminToken
ADMIN_AUTH_COOKIE_DOMAIN=
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_AUTH_TOKEN_TTL=8h
ADMIN_AUTH_LOGIN_MAX_ATTEMPTS=5
ADMIN_AUTH_LOGIN_WINDOW=10m
ADMIN_AUTH_LOGIN_LOCK=15m

ADMIN_PLANSTAR_OPS_BASE_URL=http://planstar:9108
ADMIN_PLANSTAR_OPS_TOKEN=
ADMIN_PLANSTAR_OPS_TIMEOUT=5s

ADMIN_NOTIFY_SMS_ENABLED=false
ADMIN_NOTIFY_SMS_PROVIDER=
ADMIN_NOTIFY_SMS_ENDPOINT=
ADMIN_NOTIFY_SMS_ACCESS_KEY=
ADMIN_NOTIFY_SMS_ACCESS_SECRET=
ADMIN_NOTIFY_SMS_SIGN_NAME=
ADMIN_NOTIFY_SMS_TEMPLATE_CODE=
ADMIN_NOTIFY_EMAIL_ENABLED=false
ADMIN_NOTIFY_EMAIL_PROVIDER=
ADMIN_NOTIFY_EMAIL_SMTP_HOST=
ADMIN_NOTIFY_EMAIL_SMTP_PORT=0
ADMIN_NOTIFY_EMAIL_USERNAME=
ADMIN_NOTIFY_EMAIL_PASSWORD=
ADMIN_NOTIFY_EMAIL_FROM=

ADMIN_STORAGE_OSS_ENABLED=false
ADMIN_STORAGE_OSS_PROVIDER=
ADMIN_STORAGE_OSS_ENDPOINT=
ADMIN_STORAGE_OSS_REGION=
ADMIN_STORAGE_OSS_BUCKET=
ADMIN_STORAGE_OSS_ACCESS_KEY=
ADMIN_STORAGE_OSS_ACCESS_SECRET=
ADMIN_STORAGE_OSS_CDN_HOST=
ADMIN_STORAGE_OSS_PRESIGN_TTL_SECONDS=0
