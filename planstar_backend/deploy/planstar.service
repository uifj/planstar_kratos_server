[Unit]
Description=Planstar production stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=planstar
Group=planstar
# APP_DIR 由 deploy.sh / release.yml 部署时确定，默认 /opt/planstar_backend。
WorkingDirectory=/opt/planstar_backend
# 低配档位：config.lite.yaml；全量档位改 PLANSTAR_CONFIG_FILE=config.prod.yaml
# 并追加 Environment=COMPOSE_PROFILES=full。
Environment=PLANSTAR_CONFIG_FILE=config.lite.yaml
# 三文件合并顺序与 up-prod.sh / release.yml 保持一致。
ExecStart=/usr/bin/docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.server.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.server.yml stop
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
