# 复制为 .env 后按需修改（.env 已被 git 忽略，切勿提交真实口令）
# cp .env.example .env

# ---- 基础设施口令 ----
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=root
RABBITMQ_USER=root
RABBITMQ_PASS=root

# ---- 应用镜像目标（生产部署推送到 GitHub Container Registry）----
PLANSTAR_IMAGE=ghcr.io/uifj/planstar-api
PLANSTAR_TAG=latest
VERSION=dev

# ---- 可观测面板 ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---- 一键远程部署（供 ./deploy.sh 使用）----
# 远程单服务器 SSH 信息（service_host 用 docker-compose 服务名，无需改）
SERVER_HOST=
SERVER_USER=root
SERVER_PORT=22
# 远程仓库克隆目录（需先 git clone 本仓库到此目录）
APP_DIR=/opt/planstar