# 复制为 .env 后按需修改（.env 已被 git 忽略，切勿提交真实口令）
# cp .env.example .env

# ---- 部署档位（低配 / 全量）----
# 低配档位（4C8G / 2M 带宽单机，推荐）：config.lite.yaml + prod overlay + server overlay
#   PLANSTAR_CONFIG_FILE=config.lite.yaml
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.server.yml up -d
# 全量档位：PLANSTAR_CONFIG_FILE 留空（默认 config.prod.yaml），再开启重组件 profile
#   COMPOSE_PROFILES=full
PLANSTAR_CONFIG_FILE=
COMPOSE_PROFILES=

# ---- 基础设施口令 ----
MYSQL_ROOT_PASSWORD=root
REDIS_PASSWORD=root
RABBITMQ_USER=root
RABBITMQ_PASS=root

# ---- 应用镜像目标（生产部署推送到 GitHub Container Registry）----
PLANSTAR_IMAGE=ghcr.io/uifj/planstar-api
PLANSTAR_TAG=latest
VERSION=dev

# ---- 运营后台镜像（admin.planstar.top；tag 建议固定 commit SHA）----
ADMIN_IMAGE=ghcr.io/uifj/planstar-admin
ADMIN_TAG=latest
ADMIN_WEB_IMAGE=ghcr.io/uifj/planstar-admin-web
ADMIN_WEB_TAG=latest

# ---- 可观测面板 ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ---- 运维端点鉴权 ----
# 9108 的 /metrics 与 /admin* 需要 Bearer 令牌；生产必须设置，为空则仅适合本地开发
PLANSTAR_OPS_TOKEN=
# 运维端点来源白名单（逗号分隔 CIDR，取 TCP 对端地址；留空表示不限制）
# 示例：10.0.0.0/8,192.168.1.0/24
PLANSTAR_OPS_ALLOWED_CIDRS=

# ---- 运营后台 admin（密钥全部留空，生产由密钥管理注入）----
# 默认 root/root 仅用于本地；生产必须改为最小权限账号，并同步修改 MYSQL_ROOT_PASSWORD 与 DSN。
ADMIN_DATA_DATABASE_SOURCE=root:root@tcp(mysql:3306)/planstar_admin?timeout=5s&parseTime=True&loc=Asia%2FShanghai&charset=utf8mb4
ADMIN_DATA_REDIS_ADDR=redis:6379
# 必须 >= 32 字节，且与业务 JWT_SIGNING_KEY 不同；为空时生产启动失败
ADMIN_AUTH_JWT_SECRET=
ADMIN_AUTH_COOKIE_NAME=psAdminToken
# 建议留空（host-only，仅 admin.planstar.top）；如需共享再显式设为 .planstar.top
ADMIN_AUTH_COOKIE_DOMAIN=
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_PLANSTAR_OPS_BASE_URL=http://planstar:9108
# 必须与 PLANSTAR_OPS_TOKEN 保持一致；否则审核/举报处置返回 503/401
ADMIN_PLANSTAR_OPS_TOKEN=

# ---- 短信 / 邮件 / 对象存储（默认关闭；全部留空即关闭）----
# 短信走阿里云号码认证 Dypnsapi：provider=aliyun（兼容 aliyun-dypns），
# endpoint 缺省 dypnsapi.aliyuncs.com；短信模板变量必须为 ${code}。
# enabled 非 true 时不发送；开发环境验证码打印到日志，生产环境静默丢弃。
PLANSTAR_NOTIFY_SMS_ENABLED=false
PLANSTAR_NOTIFY_SMS_PROVIDER=
PLANSTAR_NOTIFY_SMS_ENDPOINT=
PLANSTAR_NOTIFY_SMS_ACCESS_KEY=
PLANSTAR_NOTIFY_SMS_ACCESS_SECRET=
PLANSTAR_NOTIFY_SMS_SIGN_NAME=
PLANSTAR_NOTIFY_SMS_TEMPLATE_CODE=
# SMTP 邮件：provider 目前仅占位；端口 465（SSL）或 587（STARTTLS）
PLANSTAR_NOTIFY_EMAIL_ENABLED=false
PLANSTAR_NOTIFY_EMAIL_PROVIDER=
PLANSTAR_NOTIFY_EMAIL_SMTP_HOST=
PLANSTAR_NOTIFY_EMAIL_SMTP_PORT=465
PLANSTAR_NOTIFY_EMAIL_USERNAME=
PLANSTAR_NOTIFY_EMAIL_PASSWORD=
PLANSTAR_NOTIFY_EMAIL_FROM=
# 对象存储 OSS：provider=aliyun（兼容 oss）；presign TTL 为 0 表示使用默认 900 秒
PLANSTAR_STORAGE_OSS_ENABLED=false
PLANSTAR_STORAGE_OSS_PROVIDER=
PLANSTAR_STORAGE_OSS_ENDPOINT=
PLANSTAR_STORAGE_OSS_REGION=
PLANSTAR_STORAGE_OSS_BUCKET=
PLANSTAR_STORAGE_OSS_ACCESS_KEY=
PLANSTAR_STORAGE_OSS_ACCESS_SECRET=
PLANSTAR_STORAGE_OSS_CDN_HOST=
PLANSTAR_STORAGE_OSS_PRESIGN_TTL_SECONDS=0

# ---- admin 侧短信 / 邮件 / OSS（与 PLANSTAR_* 同构，默认关闭）----
ADMIN_NOTIFY_SMS_ENABLED=false
ADMIN_NOTIFY_SMS_PROVIDER=
ADMIN_NOTIFY_SMS_ENDPOINT=
ADMIN_NOTIFY_SMS_ACCESS_KEY=
ADMIN_NOTIFY_SMS_ACCESS_SECRET=
ADMIN_NOTIFY_SMS_SIGN_NAME=
ADMIN_NOTIFY_SMS_TEMPLATE_CODE=
ADMIN_NOTIFY_EMAIL_ENABLED=false
ADMIN_NOTIFY_EMAIL_PROVIDER=
ADMIN_NOTIFY_EMAIL_SMTP_HOST=
ADMIN_NOTIFY_EMAIL_SMTP_PORT=465
ADMIN_NOTIFY_EMAIL_USERNAME=
ADMIN_NOTIFY_EMAIL_PASSWORD=
ADMIN_NOTIFY_EMAIL_FROM=
ADMIN_STORAGE_OSS_ENABLED=false
ADMIN_STORAGE_OSS_PROVIDER=
ADMIN_STORAGE_OSS_ENDPOINT=
ADMIN_STORAGE_OSS_REGION=
ADMIN_STORAGE_OSS_BUCKET=
ADMIN_STORAGE_OSS_ACCESS_KEY=
ADMIN_STORAGE_OSS_ACCESS_SECRET=
ADMIN_STORAGE_OSS_CDN_HOST=
ADMIN_STORAGE_OSS_PRESIGN_TTL_SECONDS=3600

# ---- Alertmanager 邮件通知（compose 注入 AM_*）----
# 示例：smtp.example.com:587 / planstar-alert@example.com / ops@example.com
AM_SMTP_SMARTHOST=
AM_SMTP_FROM=
AM_SMTP_AUTH_USERNAME=
AM_SMTP_AUTH_PASSWORD=
AM_ALERT_EMAIL_TO=

# ---- Traefik / HTTPS（可选，启用 websecure 时填写）----
ACME_EMAIL=ops@example.com

# ---- 一键远程部署（供 ./deploy.sh 使用）----
# 远程单服务器 SSH 信息（service_host 用 docker-compose 服务名，无需改）
SERVER_HOST=
SERVER_USER=root
SERVER_PORT=22
# 远程仓库克隆目录（需先 git clone 本仓库到此目录）
APP_DIR=/opt/planstar