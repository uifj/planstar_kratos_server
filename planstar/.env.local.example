# ---------------------------------------------------------------------------
# 本地开发/联调版本环境变量（仅本机使用）
#   cp .env.local.example .env.local
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d --build
#
# !! 这些是测试口令，严禁用于任何对外环境 !!
# ---------------------------------------------------------------------------

# 本地 MySQL / Redis 测试口令（不配置时 compose 内已有同样的默认值）
MYSQL_ROOT_PASSWORD=planstar_local_only
REDIS_PASSWORD=planstar_local_only

# 端口绑定：默认只绑回环；真机联调时改为 0.0.0.0
# Flutter 模拟器用 http://10.0.2.2:8098/ ，真机用 http://<宿主机局域网IP>:8098/
PLANSTAR_LOCAL_BIND=127.0.0.1

# 本地演示账号（来自 sql/15_auth_support.sql）：
#   手机号 13800000001 / 13800000002，测试口令见 conf.LocalTestCredentialPassword
# 生产版本会通过 21_disable_test_accounts.sql +
# AssertNoTestCredentials 启动断言彻底禁用，本文件不参与生产编排。
