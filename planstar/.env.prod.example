# ---------------------------------------------------------------------------
# 企划星生产上线版本环境变量（4 核 8G / 2M 带宽单机）
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   # 逐项替换全部 <REPLACE_ME>，然后执行 ./deploy/preflight.sh
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# 约束：本文件不含任何真实密钥；<REPLACE_ME> 未替换时 preflight.sh 会拒绝发布。
# 取值位置与验证命令见 planstar_manual_setup/.trae/manual-setup-guide.md
# ---------------------------------------------------------------------------

# ---- 档位：生产使用 4C8G 低配配置（ES/MQ/Consul/tracing 关闭）----
PLANSTAR_CONFIG_FILE=config.lite.yaml
COMPOSE_PROFILES=

# ---- 镜像（必须固定语义化版本，禁止 latest）----
PLANSTAR_IMAGE=ghcr.io/uifj/planstar-api
PLANSTAR_TAG=<REPLACE_ME>
VERSION=<REPLACE_ME>
ADMIN_IMAGE=ghcr.io/uifj/planstar-admin
ADMIN_TAG=<REPLACE_ME>
ADMIN_WEB_IMAGE=ghcr.io/uifj/planstar-admin-web
ADMIN_WEB_TAG=<REPLACE_ME>

# ---- 基础设施口令（用 openssl rand -base64 32 生成，禁止 root/admin/123456）----
MYSQL_ROOT_PASSWORD=<REPLACE_ME>
REDIS_PASSWORD=<REPLACE_ME>
PLANSTAR_APP_DB_USER=planstar_app
PLANSTAR_APP_DB_PASSWORD=<REPLACE_ME>
RABBITMQ_USER=<REPLACE_ME>
RABBITMQ_PASS=<REPLACE_ME>
GF_SECURITY_ADMIN_USER=planstar_ops
GF_SECURITY_ADMIN_PASSWORD=<REPLACE_ME>

# ---- 运维端点（令牌 + 来源白名单，二者缺一启动失败）----
# 生成：openssl rand -hex 32
PLANSTAR_OPS_TOKEN=<REPLACE_ME>
# 取 TCP 对端地址；compose 内网与回环需包含，例：127.0.0.1/32,172.16.0.0/12
PLANSTAR_OPS_ALLOWED_CIDRS=127.0.0.1/32,172.16.0.0/12

# ---- 验证码入库摘要密钥（与运维令牌不同的独立随机值）----
# 生成：openssl rand -hex 32
PLANSTAR_AUTH_CODE_HMAC_KEY=<REPLACE_ME>

# ---- 运营后台 admin ----
# 使用最小权限账号，替换 <REPLACE_ME> 为与 PLANSTAR_APP_DB_PASSWORD 一致的值
ADMIN_DATA_DATABASE_SOURCE=planstar_app:<REPLACE_ME>@tcp(mysql:3306)/planstar_admin?timeout=5s&parseTime=True&loc=Asia%2FShanghai&charset=utf8mb4
ADMIN_DATA_REDIS_ADDR=redis:6379
ADMIN_DATA_REDIS_DB=0
# >= 32 字节随机串，且与业务侧密钥不同
ADMIN_AUTH_JWT_SECRET=<REPLACE_ME>
ADMIN_AUTH_COOKIE_NAME=psAdminToken
ADMIN_AUTH_COOKIE_DOMAIN=
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_PLANSTAR_OPS_BASE_URL=http://planstar:9108
# 必须与 PLANSTAR_OPS_TOKEN 保持一致
ADMIN_PLANSTAR_OPS_TOKEN=<REPLACE_ME>

# ---- 阿里云短信（已开通；生产唯一允许的验证码通道）----
# ！！上线前核实开通产品：dypnsapi(号码认证 SendSmsVerifyCode)
#    与传统 dysmsapi(国内短信 SendSms + 签名/模板) 是两套不同 SDK/模板机制。
#    当前代码按 .trae 规格实现 dypnsapi，若实际开通的是 dysmsapi 需切换 provider。
PLANSTAR_NOTIFY_SMS_ENABLED=true
PLANSTAR_NOTIFY_SMS_PROVIDER=aliyun
PLANSTAR_NOTIFY_SMS_ENDPOINT=dypnsapi.aliyuncs.com
PLANSTAR_NOTIFY_SMS_ACCESS_KEY=<REPLACE_ME>
PLANSTAR_NOTIFY_SMS_ACCESS_SECRET=<REPLACE_ME>
PLANSTAR_NOTIFY_SMS_SIGN_NAME=<REPLACE_ME>
PLANSTAR_NOTIFY_SMS_TEMPLATE_CODE=<REPLACE_ME>

# ---- 阿里云 OSS（已开通）----
PLANSTAR_STORAGE_OSS_ENABLED=true
PLANSTAR_STORAGE_OSS_PROVIDER=aliyun
PLANSTAR_STORAGE_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
PLANSTAR_STORAGE_OSS_REGION=cn-hangzhou
PLANSTAR_STORAGE_OSS_BUCKET=<REPLACE_ME>
PLANSTAR_STORAGE_OSS_ACCESS_KEY=<REPLACE_ME>
PLANSTAR_STORAGE_OSS_ACCESS_SECRET=<REPLACE_ME>
PLANSTAR_STORAGE_OSS_CDN_HOST=
PLANSTAR_STORAGE_OSS_PRESIGN_TTL_SECONDS=900

# ---- 告警通道（不得留空，否则 critical 告警无法送达）----
AM_SMTP_SMARTHOST=<REPLACE_ME>
AM_SMTP_FROM=<REPLACE_ME>
AM_SMTP_AUTH_USERNAME=<REPLACE_ME>
AM_SMTP_AUTH_PASSWORD=<REPLACE_ME>
AM_ALERT_EMAIL_TO=<REPLACE_ME>

# ---- Traefik / HTTPS ----
ACME_EMAIL=<REPLACE_ME>
# 火山引擎 DNS API 密钥（dnsChallenge 申请 Let's Encrypt 证书用，prod overlay 强制必填）
VOLC_ACCESSKEY=<REPLACE_ME>
VOLC_SECRETKEY=<REPLACE_ME>

# ---- 一键远程部署（可选）----
SERVER_HOST=
SERVER_USER=planstar
SERVER_PORT=22
APP_DIR=/opt/planstar

# ---- admin 侧可选外部服务（与业务侧同构，未启用时留空）----
ADMIN_NOTIFY_SMS_ENABLED=false
ADMIN_NOTIFY_EMAIL_ENABLED=false
ADMIN_STORAGE_OSS_ENABLED=false
