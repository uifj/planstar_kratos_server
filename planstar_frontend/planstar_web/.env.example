# 本地：http://127.0.0.1:8098/
PLANSTAR_API_BASE=http://127.0.0.1:8098/

# 服务端请求超时（毫秒）
PLANSTAR_API_TIMEOUT_MS=15000

# 站点公开地址（用于 metadata / sitemap）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
